{
  "name": "shopify-oauth-worker",
  "version": "1.0.0",
  "description": "A Cloudflare Worker that provides OAuth authentication and API gateway for browser extensions to connect with Shopify storefronts",
  "main": "worker.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy": "./deployment/deploy.sh",
    "dev": "wrangler dev",
    "publish": "wrangler publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint && npm run format:check && npm run test",
    "prepare": "husky install"
  },
  "keywords": [
    "shopify",
    "oauth",
    "cloudflare",
    "worker",
    "api",
    "gateway",
    "browser-extension"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JungleM0nkey/shopify-oauth-worker.git"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.57.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {},
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
